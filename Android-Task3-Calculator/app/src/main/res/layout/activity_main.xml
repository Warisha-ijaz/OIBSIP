<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/eyebrow" android:textColor="@color/accent" android:textSize="11sp" android:letterSpacing="0.14" android:textStyle="bold" android:layout_marginTop="12dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/title" android:textColor="@color/ink" android:textSize="32sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/subtitle" android:textColor="@color/muted" android:textSize="15sp" android:layout_marginTop="6dp" android:layout_marginBottom="24dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/display" android:padding="22dp">
<TextView android:id="@+id/expression" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="28dp" android:gravity="end" android:textColor="@color/muted" android:textSize="17sp"/>
<TextView android:id="@+id/display" android:layout_width="match_parent" android:layout_height="76dp" android:gravity="end|center_vertical" android:text="0" android:textColor="@color/ink" android:textSize="44sp" android:textStyle="bold" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="44sp" android:autoSizeStepGranularity="1sp" android:accessibilityLiveRegion="polite" android:textIsSelectable="true"/>
<TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="24dp" android:gravity="end" android:textColor="@color/muted" android:textSize="12sp"/>
</LinearLayout>
<GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="4" android:rowCount="5" android:alignmentMode="alignMargins" android:layout_marginTop="18dp"><Button android:id="@+id/clear" style="@style/OperatorKey" android:text="C" android:contentDescription="@string/clear"/><Button android:id="@+id/backspace" style="@style/OperatorKey" android:text="⌫" android:contentDescription="@string/backspace"/><Button android:id="@+id/sign" style="@style/OperatorKey" android:text="±" android:contentDescription="@string/sign"/><Button android:id="@+id/divide" style="@style/OperatorKey" android:text="÷" android:contentDescription="@string/divide"/><Button android:id="@+id/digit7" style="@style/Key" android:text="7"/><Button android:id="@+id/digit8" style="@style/Key" android:text="8"/><Button android:id="@+id/digit9" style="@style/Key" android:text="9"/><Button android:id="@+id/multiply" style="@style/OperatorKey" android:text="×" android:contentDescription="@string/multiply"/><Button android:id="@+id/digit4" style="@style/Key" android:text="4"/><Button android:id="@+id/digit5" style="@style/Key" android:text="5"/><Button android:id="@+id/digit6" style="@style/Key" android:text="6"/><Button android:id="@+id/minus" style="@style/OperatorKey" android:text="−" android:contentDescription="@string/minus"/><Button android:id="@+id/digit1" style="@style/Key" android:text="1"/><Button android:id="@+id/digit2" style="@style/Key" android:text="2"/><Button android:id="@+id/digit3" style="@style/Key" android:text="3"/><Button android:id="@+id/plus" style="@style/OperatorKey" android:text="+" android:contentDescription="@string/plus"/><Button android:id="@+id/digit0" style="@style/Key" android:text="0"/><Button android:id="@+id/decimal" style="@style/Key" android:text="." android:contentDescription="@string/decimal"/><Button android:id="@+id/equals" style="@style/EqualsKey" android:text="=" android:layout_columnSpan="2" android:layout_columnWeight="2" android:contentDescription="@string/equals"/></GridLayout><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/footer" android:gravity="center" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginTop="18dp" android:layout_marginBottom="12dp"/></LinearLayout></ScrollView>
