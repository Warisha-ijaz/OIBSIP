<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/eyebrow" android:textColor="@color/accent" android:textSize="11sp" android:letterSpacing="0.14" android:textStyle="bold" android:layout_marginTop="12dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/title" android:textColor="@color/ink" android:textSize="32sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/subtitle" android:textColor="@color/muted" android:textSize="15sp" android:layout_marginTop="6dp" android:layout_marginBottom="24dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card" android:padding="20dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/category" android:textColor="@color/muted" android:textSize="14sp" android:layout_marginTop="16dp" android:layout_marginBottom="6dp"/><Spinner android:id="@+id/category" android:layout_width="match_parent" android:layout_height="52dp" android:backgroundTint="@color/accent" android:spinnerMode="dropdown"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/value" android:textColor="@color/muted" android:textSize="14sp" android:layout_marginTop="16dp" android:layout_marginBottom="6dp"/>
<EditText android:id="@+id/value" android:layout_width="match_parent" android:layout_height="60dp" android:hint="@string/hint" android:textColor="@color/ink" android:textColorHint="@color/muted" android:textSize="24sp" android:inputType="numberDecimal|numberSigned" android:singleLine="true" android:imeOptions="actionDone" android:maxLength="100"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/from" android:textColor="@color/muted" android:textSize="14sp" android:layout_marginTop="16dp" android:layout_marginBottom="6dp"/><Spinner android:id="@+id/from" android:layout_width="match_parent" android:layout_height="52dp" android:backgroundTint="@color/accent" android:spinnerMode="dropdown"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/to" android:textColor="@color/muted" android:textSize="14sp" android:layout_marginTop="16dp" android:layout_marginBottom="6dp"/><Spinner android:id="@+id/to" android:layout_width="match_parent" android:layout_height="52dp" android:backgroundTint="@color/accent" android:spinnerMode="dropdown"/>
<Button android:id="@+id/swap" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/swap" android:textAllCaps="false" android:textColor="@color/accent" style="?android:attr/borderlessButtonStyle"/>
<Button android:id="@+id/convert" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/button" android:backgroundTint="@color/accent" android:text="@string/convert" android:textAllCaps="false" android:textSize="17sp" android:textColor="@color/white"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp" android:layout_marginTop="20dp" android:background="@drawable/result">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/result_label" android:textColor="@color/accent" android:textSize="11sp" android:letterSpacing="0.1" android:textStyle="bold"/>
<TextView android:id="@+id/result" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/empty_result" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/ink" android:accessibilityLiveRegion="polite" android:textIsSelectable="true"/>
<TextView android:id="@+id/detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/help" android:textColor="@color/muted" android:textSize="14sp"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/footer" android:textColor="@color/muted" android:textSize="12sp" android:gravity="center" android:layout_marginTop="24dp" android:layout_marginBottom="12dp"/>
</LinearLayout></ScrollView>
